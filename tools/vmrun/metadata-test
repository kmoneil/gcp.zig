#!/bin/bash
# metadata-test: auth.MetadataServer's key reads against Google, on a
# spot VM. It runs jobs/metadata.sh, which runs the gated suite
# tests/auth_metadata_gcp_integration.zig (the calls, and the in-memory
# fake held to the server's answers) and then examples/spot_worker.zig;
# once the worker is watching instance/preempted, it asks Compute to
# simulate a maintenance event, which on a spot VM is a preemption, as
# preempt-test does. It passes when the suite passed and the worker said
# it was preempted. About 10 minutes and a cent of spot time; run it
# after changing how MetadataServer reads keys or how the fake answers.
#
#   tools/vmrun/metadata-test
#
# The key as vmrun takes it: GCP_KEY, else ~/.gcp-keys/zig-gcp-sa-key.json.
set -u
HERE=$(cd "$(dirname "$0")" && pwd -P)
ROOT=$(cd "$(git -C "$HERE" rev-parse --show-toplevel)" && pwd -P)
KEY=${GCP_KEY:-$HOME/.gcp-keys/zig-gcp-sa-key.json}
LOG=$(mktemp)
trap 'rm -f "$LOG"' EXIT
cd "$ROOT"
ms() { python3 -I -c 'import time; print(f"{time.time():.3f}")'; }

"$HERE/vmrun" --spot tools/vmrun/jobs/metadata.sh > "$LOG" 2>&1 &
pid=$!
watching=""
for _ in $(seq 1 360); do
  grep -q '^vmrun: watching for preemption' "$LOG" && { watching=1; break; }
  kill -0 "$pid" 2> /dev/null || break
  sleep 5
done
if [ -z "$watching" ]; then
  kill "$pid" 2> /dev/null; wait "$pid"
  cat "$LOG"; echo "metadata-test: FAIL, the worker never started watching"; exit 1
fi
line=$(grep -m1 ' started in ' "$LOG")
VM=$(echo "$line" | awk '{print $2}') ZONE=$(echo "$line" | awk '{print $5}')

# A token as vmrun mints one: a JWT signed with the key, traded at Google.
b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
hdr=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
claim=$(printf '{"iss":"%s","scope":"https://www.googleapis.com/auth/cloud-platform","aud":"https://oauth2.googleapis.com/token","iat":%d,"exp":%d}' "$(jq -r .client_email "$KEY")" "$now" $((now + 3600)) | b64)
pem=$(mktemp); (umask 077; jq -r .private_key "$KEY" > "$pem")
sig=$(printf '%s.%s' "$hdr" "$claim" | openssl dgst -sha256 -sign "$pem" | b64); rm -f "$pem"
T=$(curl -s https://oauth2.googleapis.com/token --data-urlencode grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer \
  --data-urlencode assertion="$hdr.$claim.$sig" | jq -r .access_token)

asked=$(ms)
r=$(curl -s -X POST -H "Authorization: Bearer $T" -H "Content-Length: 0" \
  "https://compute.googleapis.com/compute/v1/projects/$(jq -r .project_id "$KEY")/zones/$ZONE/instances/$VM/simulateMaintenanceEvent")
unset T
err=$(printf '%s' "$r" | jq -r '.error.message // empty')
if [ -n "$err" ]; then
  kill "$pid" 2> /dev/null; wait "$pid"
  cat "$LOG"; echo "metadata-test: FAIL, simulateMaintenanceEvent: $err"; exit 1
fi
echo "metadata-test: preempting $VM in $ZONE at $asked"

wait "$pid"; code=$?
cat "$LOG"
out=$(sed -n 's/^vmrun: salvaged .* in \(_vmrun\/.*\)$/\1/p; s/^vmrun: exit .*; results in \(_vmrun\/.*\)$/\1/p' "$LOG" | tail -1)
suite=$( [ -n "$out" ] && cat "$out/suite.exit" 2> /dev/null )
seen=$( [ -n "$out" ] && sed -n 's/^preempted at \([0-9.]*\) .*/\1/p' "$out/worker.log" 2> /dev/null )
if [ "$suite" = 0 ] && [ -n "$seen" ]; then
  echo "metadata-test: ok, the suite passed and the worker saw the preemption $(python3 -I -c "print(f'{$seen - $asked:.1f}')") s after it was asked for (vmrun exited $code)"
else
  echo "metadata-test: FAIL, vmrun exited $code; the suite's exit: ${suite:-none}, the worker's preemption line: ${seen:-none} (in ${out:-nowhere})"; exit 1
fi
