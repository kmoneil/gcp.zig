#!/bin/bash
# blip-test: vmrun against a fake Google, offline, in under a minute.
# A fake curl answers the calls vmrun makes from a state
# directory; fake sleep and date keep a clock that moves only when vmrun
# sleeps, so an hour of waiting takes seconds. Each case drops the
# network for a stretch of that clock, or takes away a few answers to one
# kind of call, and checks vmrun's exit code, what it said, what it
# brought home and what it left on Google. Run it after changing how
# vmrun talks to Google; tools/vmrun/preempt-test is the one against
# Google itself.
#
#   tools/vmrun/blip-test
#   VERBOSE=1 tools/vmrun/blip-test     # vmrun's output for every case
#
# Needs bash, jq, openssl, git and tar, as vmrun does, and no network.
set -u
HERE=$(cd "$(dirname "$0")" && pwd -P)
W=$(mktemp -d)
trap 'rm -rf "$W"' EXIT
G=$W/google
START=1800000000
mkdir -p "$W/bin" "$W/repo/jobs"

# The clock: `date +%s` reads it, sleep moves it; any other date is real.
REAL_DATE=$(command -v date)
cat > "$W/bin/date" << EOF
#!/bin/bash
if [ "\$*" = +%s ]; then read -r now < "$G/clock"; echo "\$now"; else exec "$REAL_DATE" "\$@"; fi
EOF
cat > "$W/bin/sleep" << EOF
#!/bin/bash
read -r now < "$G/clock"; echo \$((now + \${1%s})) > "$G/clock"
EOF

# Google, as curl. Its state, in $FAKE_G: clock; down, a line "from to"
# per stretch with no network (clock values); fail, busy and cut, a line
# "route count" per kind of call whose next count calls get no answer, a
# 429, or half their body; bucket, vm and vm_at once made; job_secs and
# job_exit for the job; deleted objects, vm_gone and bucket_gone; refuse
# to turn the key down; log, every call.
cat > "$W/bin/curl" << 'EOF'
#!/bin/bash
set -u
G=$FAKE_G
read -r now < "$G/clock"
method="" out="" fmt="" fail="" url="" data="" auth="" get=""
while [ $# -gt 0 ]; do
  case $1 in
    -s) shift ;;
    -G) get=1; shift ;;
    -f) fail=1; shift ;;
    -X) method=$2; shift 2 ;;
    -H) case $2 in "Authorization: Bearer "*) auth=${2#Authorization: Bearer } ;; esac; shift 2 ;;
    -o) out=$2; shift 2 ;;
    -w) fmt=$2; shift 2 ;;
    -d|--data-binary|--data-urlencode) data=$2; shift 2 ;;
    -*) echo "$now unknown option $1" >> "$G/log"; exit 2 ;;
    *) url=$1; shift ;;
  esac
done
if [ -z "$method" ]; then
  if [ -n "$data" ] && [ -z "$get" ]; then method=POST; else method=GET; fi
fi
path=${url%%\?*} query=""
case $url in *\?*) query=${url#*\?} ;; esac
vm="" bk="" job_done=""
[ ! -f "$G/vm" ] || read -r vm < "$G/vm"
[ ! -f "$G/bucket" ] || read -r bk < "$G/bucket"
if [ -f "$G/vm_at" ]; then
  read -r at < "$G/vm_at"; read -r secs < "$G/job_secs"
  [ $((now - at)) -lt "$secs" ] || job_done=1
fi
# A VM that dies mid-job (vm_dies, seconds after it was made) is gone,
# deleted at its wall or taken by Google (preempted, then), with only the
# minute-synced log uploaded.
died=""
if [ -f "$G/vm_at" ] && [ -f "$G/vm_dies" ]; then
  read -r dies < "$G/vm_dies"
  [ $((now - at)) -lt "$dies" ] || died=1
fi

B=https://storage.googleapis.com/storage/v1/b
route=unknown name=""
case "$method $path" in
  "POST https://oauth2.googleapis.com/token") route=token ;;
  "GET "*/global/images/family/*) route=image ;;
  "POST $B") route=bucket-create ;;
  "POST https://storage.googleapis.com/upload/storage/v1/b/"*/o) route=upload ;;
  "POST "*/zones/*/instances) route=vm-create ;;
  "GET "*/zones/*/operations) route=ops ;;
  "GET "*/zones/*/operations/*) route=op ;;
  "GET "*/zones/*/instances/*/serialPort) route=console ;;
  "GET "*/zones/*/instances/*) route=vm-get ;;
  "DELETE "*/zones/*/instances/*) route=vm-delete ;;
  "GET $B/"*/o) case $query in prefix=results/) route=list-results ;; *) route=list-all ;; esac ;;
  "GET $B/"*/o/*|"DELETE $B/"*/o/*)
    name=$(printf '%s' "${path##*/o/}" | sed 's|%2F|/|g')
    case "$method $query" in
      "GET alt=media") route=download:$name ;;
      GET*) route=exists ;;
      *) route=delete-object ;;
    esac ;;
  "DELETE $B/"*) route=delete-bucket ;;
esac
log() { echo "$now $route $method $url -> $1" >> "$G/log"; }

# No network: no answer at all, as when curl cannot resolve the host.
while read -r from to; do
  if [ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]; then log down; exit 6; fi
done < "$G/down"
# Whether a rule in the file named ("route count" lines) takes this call,
# one of its count.
take() {
  local hit="" r n
  [ -s "$G/$1" ] || return 1
  : > "$G/$1.new"
  while read -r r n; do
    if [ -z "$hit" ] && [ "$r" = "$route" ] && [ "$n" -gt 0 ]; then hit=1; n=$((n - 1)); fi
    echo "$r $n" >> "$G/$1.new"
  done < "$G/$1"
  mv "$G/$1.new" "$G/$1"
  [ -n "$hit" ]
}
# A blip on this kind of call: no answer.
if take fail; then log blip; exit 6; fi

objects() {
  { [ ! -f "$G/uploaded" ] || echo src.tgz
    [ -z "$vm" ] || echo results/stage
    [ -z "$died" ] || echo results/job.log
    [ -z "$job_done" ] || [ -n "$died" ] || printf 'results/exit\nresults/job.log\n'
  } | grep -vxF -f "$G/deleted"
}
has() { objects | grep -qxF "$1"; }
bucket_ok() { local b=${path#*/b/}; b=${b%%/*}; [ -n "$bk" ] && [ "$b" = "$bk" ] && [ ! -f "$G/bucket_gone" ]; }
nf='{"error":{"code":404,"message":"Not Found"}}'
code=200 body=""
if [ "$route" != token ]; then
  case $auth in
    tok-*) [ $((now - ${auth#tok-})) -lt 3600 ] || code=401 ;;
    *) code=401 ;;
  esac
fi
if [ "$code" = 401 ]; then
  body='{"error":{"code":401,"message":"Request had invalid authentication credentials."}}'
elif take busy; then
  code=429 body='{"error":{"code":429,"message":"Too many requests."}}'
else
  case $route in
    token)
      if [ -f "$G/refuse" ]; then code=400 body='{"error":"invalid_grant","error_description":"Invalid JWT Signature."}'
      else body="{\"access_token\":\"tok-$now\",\"expires_in\":3599,\"token_type\":\"Bearer\"}"; fi ;;
    image) body='{"name":"blip-image-1"}' ;;
    bucket-create) printf '%s' "$data" | jq -r .name > "$G/bucket"; read -r bk < "$G/bucket"; body="{\"name\":\"$bk\"}" ;;
    upload) if bucket_ok; then touch "$G/uploaded"; body='{"size":"1"}'; else code=404 body=$nf; fi ;;
    vm-create) jq -r .name "${data#@}" > "$G/vm"; echo "$now" > "$G/vm_at"; body='{"name":"op-create"}' ;;
    op) body='{"status":"DONE"}' ;;
    ops)
      if [ -n "$died" ] && [ -f "$G/preempted" ]; then body='{"items":[{"operationType":"compute.instances.preempted"}]}'
      else body='{"items":[]}'; fi ;;
    console) body='{"contents":"blip console"}' ;;
    vm-get|vm-delete)
      if [ "${path##*/}" != "$vm" ] || [ -f "$G/vm_gone" ] || [ -n "$died" ]; then code=404 body=$nf
      elif [ "$route" = vm-get ]; then body='{"status":"RUNNING","scheduling":{"provisioningModel":"SPOT"}}'
      else touch "$G/vm_gone"; body='{"name":"op-delete"}'; fi ;;
    list-results|list-all)
      if bucket_ok; then
        if [ "$route" = list-all ]; then body=$(objects | jq -R . | jq -sc '{items: map({name: .})}')
        else body=$(objects | grep '^results/' | jq -R . | jq -sc '{items: map({name: .})}'); fi
      else code=404 body=$nf; fi ;;
    exists) if bucket_ok && has "$name"; then body="{\"name\":\"$name\"}"; else code=404 body=$nf; fi ;;
    download:*)
      if bucket_ok && has "$name"; then
        case $name in
          results/exit) read -r body < "$G/job_exit" ;;
          results/stage) body="running jobs/test.sh" ;;
          *) body="blip $name" ;;
        esac
        body="$body"$'\n'
      else code=404 body=$nf; fi ;;
    delete-object) if bucket_ok && has "$name"; then echo "$name" >> "$G/deleted"; code=204; else code=404 body=$nf; fi ;;
    delete-bucket)
      if ! bucket_ok; then code=404 body=$nf
      elif [ -n "$(objects)" ]; then code=409 body='{"error":{"code":409,"message":"The bucket you tried to delete is not empty."}}'
      else touch "$G/bucket_gone"; code=204; fi ;;
    *) code=404 body=$nf ;;
  esac
fi
# Cut off mid-body: half of it, the status line already in, as curl's (18).
rc=0
if take cut; then body=${body:0:$(( ${#body} / 2 ))} rc=18; log "$code cut"; else log "$code"; fi
if [ -n "$fail" ] && [ "$code" -ge 400 ]; then exit 22; fi
if [ -n "$out" ]; then printf '%s' "$body" > "$out"; else printf '%s' "$body"; fi
[ -z "$fmt" ] || printf '%b' "$(printf '%s' "$fmt" | sed "s/%{http_code}/$code/g")"
exit $rc
EOF
chmod +x "$W/bin/date" "$W/bin/sleep" "$W/bin/curl"

# A repository of its own, so each run ships a few bytes, and a key.
cat > "$W/repo/build.zig.zon" << 'EOF'
.{
    .minimum_zig_version = "0.17.0",
}
EOF
cat > "$W/repo/jobs/test.sh" << 'EOF'
#!/bin/bash
# vmrun: machine=e2-standard-2
exit 0
EOF
git -C "$W/repo" init -q
git -C "$W/repo" add -A
git -C "$W/repo" -c user.name=blip -c user.email=blip@example.com -c commit.gpgsign=false commit -qm blip
openssl genrsa -out "$W/key.pem" 2048 2> /dev/null
jq -n --rawfile pem "$W/key.pem" '{project_id: "blip", client_email: "vmrun@blip.iam.gserviceaccount.com", private_key: $pem}' > "$W/key.json"

FAILED=0 NAME="" BAD="" CODE=""
# A case: a fresh Google; the job takes a minute and exits 3.
begin() {
  NAME=$1 BAD=""
  rm -rf "$G" "$W/repo/_vmrun"
  mkdir -p "$G"
  echo "$START" > "$G/clock"
  echo 60 > "$G/job_secs"
  echo 3 > "$G/job_exit"
  echo "(none)" > "$G/deleted"
  : > "$G/down"; : > "$G/fail"; : > "$G/busy"; : > "$G/cut"; : > "$G/log"
}
down() { echo "$((START + $1)) $((START + $2))" >> "$G/down"; } # seconds from the start
fail() { echo "$1 $2" >> "$G/fail"; } # route, how many calls
busy() { echo "$1 $2" >> "$G/busy"; }
cut() { echo "$1 $2" >> "$G/cut"; }
vmrun() {
  (cd "$W/repo" && PATH="$W/bin:$PATH" GCP_KEY="$W/key.json" FAKE_G="$G" "$HERE/vmrun" "$@" jobs/test.sh) > "$W/out" 2>&1
  CODE=$?
}
no() { BAD="$BAD"$'\n'"  $*"; }
want_exit() { [ "$CODE" = "$1" ] || no "exit $CODE, want $1"; }
want_said() { grep -qE "$1" "$W/out" || no "never said /$1/"; }
want_unsaid() { ! grep -qE "$1" "$W/out" || no "said /$1/"; }
want_gone() { [ -f "$G/${1}_gone" ] || no "left the $1 on Google"; }
want_left() { [ ! -f "$G/${1}_gone" ] || no "deleted the $1"; }
want_home() {
  local d f
  d=$(echo "$W/repo/_vmrun/"*)
  for f in "$@"; do [ -f "$d/$f" ] || no "did not bring back $f"; done
}
end() {
  ! grep -q ' unknown ' "$G/log" || no "made a call the fake does not know: $(grep -m1 ' unknown ' "$G/log")"
  if [ -z "$BAD" ]; then
    echo "ok   $NAME"
    [ -z "${VERBOSE:-}" ] || sed 's/^/     | /' "$W/out"
    return
  fi
  FAILED=$((FAILED + 1))
  echo "FAIL $NAME:$BAD"
  sed 's/^/     | /' "$W/out"
}

begin "a calm run: the job's exit code and results, nothing left"
vmrun
want_exit 3; want_home exit job.log manifest.json; want_gone vm; want_gone bucket
want_said '^vmrun: deleted vmrun-test-[0-9]+ blip-vmrun-'
end

begin "no network at the start: the token is tried again"
down 0 20
vmrun
want_exit 3; want_home exit job.log; want_gone vm; want_gone bucket
end

begin "the network drops at the 45-minute token refresh, longer than one mint tries"
echo 3000 > "$G/job_secs"
down 2690 2900
vmrun
want_exit 3; want_home exit job.log; want_gone vm; want_gone bucket
# The refresh failed while the network was down, and came once it was back.
awk -v t=$((START + 2700)) '$2 == "token" && $1 >= t && $NF == "down" { n++ } END { exit !n }' "$G/log" ||
  no "never tried the refresh while the network was down"
awk -v t=$((START + 2900)) '$2 == "token" && $1 >= t && $NF == 200 { n++ } END { exit !n }' "$G/log" ||
  no "never refreshed the token once the network was back"
end

begin "the token endpoint answers 429 at first: tried again, not a refusal"
busy token 2
vmrun
want_exit 3; want_gone vm; want_gone bucket; want_unsaid 'refused'
end

begin "the VM's status cut off mid-body while waiting"
cut vm-get 3
vmrun
want_exit 3; want_home exit job.log; want_gone vm; want_gone bucket
grep -q ' vm-get .* cut$' "$G/log" || no "no status read was cut"
end

begin "a blip while the results come home"
fail list-results 2; fail download:results/job.log 2
vmrun
want_exit 3; want_home exit job.log; want_gone vm; want_gone bucket
end

begin "a blip on each call of the cleanup"
fail vm-delete 1; fail list-all 1; fail delete-object 1; fail delete-bucket 1
vmrun
want_exit 3; want_gone vm; want_gone bucket
want_said '^vmrun: deleted vmrun-test-[0-9]+ blip-vmrun-'
end

begin "the network goes for good while the job runs: cleanup says what it left"
echo 9999 > "$G/job_secs"
down 100 999999999
vmrun --timeout 1
want_exit 1; want_left vm; want_left bucket
want_said '^vmrun: no result after 1 minutes'
want_said '^vmrun: cannot reach Google to clean up'
want_said '^vmrun: left vmrun-test-[0-9]+ on Google'
want_said '^vmrun: left the bucket blip-vmrun-[0-9]+-[0-9a-f]+ on Google'
want_unsaid '^vmrun: deleted'
end

begin "a bucket that will not delete: said, and not called deleted"
fail delete-bucket 99
vmrun
want_exit 3; want_gone vm; want_left bucket
want_said '^vmrun: deleted vmrun-test-[0-9]+ \('
want_said '^vmrun: left the bucket blip-vmrun-[0-9]+-[0-9a-f]+ on Google'
end

begin "a result that will not download: the bucket is kept for it, and said"
fail download:results/job.log 99
vmrun
want_exit 3; want_home exit; want_gone vm; want_left bucket
want_said '^vmrun: could not bring back results/job.log; kept the bucket gs://blip-vmrun-'
end

begin "the VM dies mid-job: what it had uploaded comes home and is said, nothing left"
echo 9999 > "$G/job_secs"; echo 600 > "$G/vm_dies"
vmrun
want_exit 1; want_home job.log stage; want_gone bucket
want_said '^vmrun: the VM is GONE and reported no result'
want_said '^vmrun: salvaged 2 file\(s\) the VM had uploaded'
end

begin "a spot VM preempted mid-job: exit 75, and what it had uploaded comes home"
echo 9999 > "$G/job_secs"; echo 600 > "$G/vm_dies"; touch "$G/preempted"
vmrun
want_exit 75; want_home job.log stage; want_gone bucket
want_said 'was preempted \(a spot VM\); run it again'
want_said '^vmrun: salvaged 2 file\(s\) the VM had uploaded'
end

begin "a refused key: said at once, not tried for two minutes"
touch "$G/refuse"
vmrun
want_exit 1; want_said 'refused .*Invalid JWT Signature'
waited=$(( $(cat "$G/clock") - START ))
[ "$waited" -lt 15 ] || no "waited ${waited}s on the fake clock"
end

if [ "$FAILED" = 0 ]; then echo "blip-test: ok"; else echo "blip-test: $FAILED case(s) failed"; exit 1; fi
