// gnarl's classes for this repository (github.com/kmoneil/gnarl). A
// function over a critical limit for its class fails `zig build test`,
// unless complexity.baseline holds it at its number and it got no worse.
// A file named nowhere here is normal. There is no vendored code, so
// nothing is excluded.
.{
    // What runs per request, message, chunk or row on an application's
    // main path, held to the tightest limits: core's request loop, retries,
    // checksums and codecs (the transport is rest-core's, held to its own
    // limits there), the Pub/Sub publisher and subscriber and their
    // wire codec, Cloud Storage's streamed transfers, Firestore's document
    // codec and streams, BigQuery's row values, a log entry written or
    // tailed, and a metric point recorded.
    .hot = .{
        "src/core/rpc.zig",
        "src/core/retry.zig",
        "src/core/retry_after.zig",
        "src/core/PreparedRequest.zig",
        "src/core/crc32c.zig",
        "src/core/gzip.zig",
        "src/core/flate.zig",
        "src/core/JsonArraySplitter.zig",
        "src/core/duration.zig",
        "src/pubsub/Publisher.zig",
        "src/pubsub/Subscriber.zig",
        "src/pubsub/codec.zig",
        "src/storage/download.zig",
        "src/storage/gzip_download.zig",
        "src/storage/gzip_upload.zig",
        "src/storage/resumable.zig",
        "src/storage/parallel.zig",
        "src/storage/parallel_download.zig",
        "src/storage/upload_file.zig",
        "src/firestore/codec.zig",
        "src/firestore/stream.zig",
        "src/bigquery/values.zig",
        "src/logging/log.zig",
        "src/logging/Tail.zig",
        "src/monitoring/Recorder.zig",
    },
    // What only builds, tests, fuzzes, measures or shows: the build, the
    // tools and the benchmark, the suites under tests/, the examples, and
    // inside src the in-memory fakes, the test helpers, the answers
    // production gave (kept for tests), and the emulator differentials.
    .cold = .{
        "build.zig",
        "tools/**",
        "tests/**",
        "examples/**",
        "src/*/fake_*.zig",
        "src/*/test_util.zig",
        "src/*/production_bodies.zig",
        "src/*/emulator_diff.zig",
        "src/core/testing.zig",
        "src/pubsub/production_replay.zig",
    },
}
